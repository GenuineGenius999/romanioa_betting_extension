{
  "manifest_version": 3,
  "name": "Superbet Tennis Extension",
  "version": "1.0.0",
  "description": "Chrome extension for Superbet.ro Tennis Live Betting",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://superbet.ro/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://superbet.ro/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Superbet Tennis Extension"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
} 